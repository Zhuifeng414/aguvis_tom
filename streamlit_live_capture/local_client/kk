#!/usr/bin/env python3
from __future__ import annotations

import argparse
import shlex
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

DEFAULT_JUMP_HOST = "tuq24452@129.32.95.123"
DEFAULT_REMOTE_HOST = "tuq24452@129.32.95.51"
DEFAULT_REMOTE_DIR = "/home/tuq24452/code/GUIAgent/aguvis/streamlit_live_capture/uploads"
DEFAULT_LOCAL_DIR = Path.home() / ".aguvis_kk_captures"
DEFAULT_DELAY_SECONDS = 1.5


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Capture a local full-screen screenshot as PNG and upload it to the AGUVIS server inbox.",
    )
    parser.add_argument("--jump-host", default=DEFAULT_JUMP_HOST, help="SSH jump host used with `ssh -J`.")
    parser.add_argument("--remote-host", default=DEFAULT_REMOTE_HOST, help="Final SSH destination host.")
    parser.add_argument("--remote-dir", default=DEFAULT_REMOTE_DIR, help="Remote directory that receives uploaded PNGs.")
    parser.add_argument(
        "--local-dir",
        default=str(DEFAULT_LOCAL_DIR),
        help="Local directory where the PNG is saved before upload.",
    )
    parser.add_argument(
        "--delay",
        type=float,
        default=DEFAULT_DELAY_SECONDS,
        help="Seconds to wait before taking the screenshot so you can switch windows.",
    )
    parser.add_argument(
        "--filename-prefix",
        default="capture",
        help="Prefix used for the saved PNG filename.",
    )
    return parser.parse_args()


def build_capture_path(local_dir: Path, filename_prefix: str) -> Path:
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    return local_dir / f"{filename_prefix}_{timestamp}.png"


def capture_full_screen(output_path: Path) -> None:
    from mss import mss, tools

    with mss() as screen_capture:
        screenshot = screen_capture.grab(screen_capture.monitors[0])
        tools.to_png(screenshot.rgb, screenshot.size, output=str(output_path))


def run_command(command: list[str]) -> None:
    subprocess.run(command, check=True)


def ensure_remote_dir(jump_host: str, remote_host: str, remote_dir: str) -> None:
    remote_command = f"mkdir -p {shlex.quote(remote_dir)}"
    run_command(["ssh", "-J", jump_host, remote_host, remote_command])


def upload_capture(local_path: Path, jump_host: str, remote_host: str, remote_dir: str) -> None:
    remote_target = f"{remote_host}:{remote_dir.rstrip('/')}/"
    run_command(["scp", "-J", jump_host, str(local_path), remote_target])


def main() -> int:
    args = parse_args()
    local_dir = Path(args.local_dir).expanduser()
    local_dir.mkdir(parents=True, exist_ok=True)
    output_path = build_capture_path(local_dir, args.filename_prefix)

    if args.delay > 0:
        print(f"Capturing in {args.delay:.1f}s...")
        time.sleep(args.delay)

    capture_full_screen(output_path)
    print(f"Saved screenshot: {output_path}")

    ensure_remote_dir(args.jump_host, args.remote_host, args.remote_dir)
    upload_capture(output_path, args.jump_host, args.remote_host, args.remote_dir)
    print(f"Uploaded to: {args.remote_host}:{args.remote_dir.rstrip('/')}/{output_path.name}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("Cancelled.", file=sys.stderr)
        raise SystemExit(130)
